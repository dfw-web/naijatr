# Optional: connect NEXTSTREAM to The Movie Database (TMDB).
# Copy this file to `.env.local` and fill in ONE of the values below.
# Get free credentials at https://www.themoviedb.org/settings/api
#
# These are read only server-side — by the Vite dev/preview server locally and
# by the Vercel functions in api/ in production (set them in the Vercel project
# settings) — which proxy /api/tmdb requests and add the credential. Never read them from
# frontend code (import.meta.env) — that would bundle the secret into the site.
#
# Leave both empty to use the built-in sample catalogue.

# Preferred: "API Read Access Token" (v4 bearer token)
TMDB_READ_ACCESS_TOKEN=

# Alternative: "API Key" (v3). VITE_TMDB_API_KEY is also accepted and is
# likewise only read server-side — never reference it from src/.
TMDB_API_KEY=


# Optional: NextStream playback (read server-side only, never from src/).
# Copy the movie and TV player URL patterns from the NextStream docs.
# Placeholders: {tmdbId} {season} {episode} {apiKey}
NEXTSTREAM_API_KEY=
NEXTSTREAM_MOVIE_URL=
NEXTSTREAM_TV_URL=

# Optional: Download button. URL patterns where your server serves the video
# file for a title (same placeholders as above).
NEXTSTREAM_MOVIE_DOWNLOAD_URL=
NEXTSTREAM_TV_DOWNLOAD_URL=

# Optional: Download button options from the MovieBox Cloudflare Worker
# (server/moviebox.ts, served at /api/download/options). Server-side only:
# never read these from src/. Without the secret, Download says it's
# unavailable; Play is never affected. Subject matches
# are cached in Upstash Redis (KV_REST_API_* below) when configured.
MOVIEBOX_WORKER_URL=https://spun-moviebox-api.nextloft-clientr.workers.dev
MOVIEBOX_WORKER_SECRET=

# Optional: the Download button's jobs on the naijatr-download-worker (Render),
# served at /api/download/job... (server/workerDownloads.ts). Server-side only:
# never read these from src/ or name them VITE_*. DOWNLOAD_SOURCE_ID is the
# worker's approved source (APPROVED_SOURCES_JSON there) whose videos you are
# licensed to distribute. Without all three, the button is hidden; Play is
# never affected.
DOWNLOAD_WORKER_URL=https://naijatr-download-worker.onrender.com
WORKER_API_KEY=
DOWNLOAD_SOURCE_ID=

# Optional: Football section (/football). API-Football key from
# https://dashboard.api-football.com (read server-side only, never from src/).
API_FOOTBALL_KEY=

# Optional: match streams on football match pages, from RapidAPI's Football Live
# Streaming API (main source; its live list is shared through Upstash Redis,
# see KV_REST_API_* below) and Football Live Stream API (fallback, and the match
# list while API-Football is unavailable). One key for both; read server-side
# only, never from src/. Subscribe the key to both APIs on RapidAPI.
RAPIDAPI_KEY=

# Ads (all of them: the Monetag Multitag, direct-link ad, ad breaks). On unless
# this is "false". Read at build time; see src/config/ads.ts.
VITE_ADS_ENABLED=

# Telegram gate (src/gate): set to false to switch it off.
VITE_TELEGRAM_GATE_ENABLED=

# Live viewer counter (/api/live, private stats at /admin/live). Upstash Redis
# from the Vercel Marketplace (free plan) sets KV_REST_API_URL and
# KV_REST_API_TOKEN; a direct Upstash database's UPSTASH_REDIS_REST_URL and
# UPSTASH_REDIS_REST_TOKEN work too. Without them, heartbeats are ignored.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# The password for /admin/live. The page stays locked while this is unset.
ADMIN_PASSWORD=

# Optional: your Telegram chat id, so @naijatr_bot (TELEGRAM_BOT_TOKEN) forwards each
# new feedback message to you. Server-side only; feedback is saved in Redis either way.
ADMIN_TELEGRAM_CHAT_ID=

# ---- Referral program and the one-time "Invite & Win" contest (server/referral) ----
# Signs referral sign-ins and salts IP hashes; falls back to NAIJATR_GATE_SECRET.
# REFERRAL_SECRET=
# Encrypts winners' bank details in Redis (any long random string). Without it, winners can't submit claims.
# CLAIM_ENCRYPTION_KEY=
# The contest: "true" turns it on; times are Africa/Lagos ("YYYY-MM-DD HH:MM").
# CONTEST_ACTIVE=true
# CONTEST_START=2026-10-22 11:05
# CONTEST_END=2026-10-25 23:59
# Naira for 1st, 2nd, 3rd (default 30000,20000,10000).
# CONTEST_PRIZES=30000,20000,10000
