{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "crons": [
    { "path": "/api/referral/push?kind=night", "schedule": "40 22 * * *" },
    { "path": "/api/referral/push?kind=final", "schedule": "0 17 * * *" }
  ],
  "rewrites": [
    { "source": "/api/tmdb/:path*", "destination": "/api/tmdb?__path=:path*" },
    { "source": "/api/play/:path*", "destination": "/api/play?__path=:path*" },
    { "source": "/api/download/:path*", "destination": "/api/download?__path=:path*" },
    { "source": "/go/telegram", "destination": "/go/telegram/index.html" },
    { "source": "/admin/live", "destination": "/admin/live/index.html" },
    { "source": "/admin/feedback", "destination": "/admin/feedback/index.html" },
    { "source": "/admin/challenge", "destination": "/admin/challenge/index.html" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        { "key": "Content-Type", "value": "application/manifest+json" },
        { "key": "Cache-Control", "value": "no-cache" }
      ]
    }
  ]
}
